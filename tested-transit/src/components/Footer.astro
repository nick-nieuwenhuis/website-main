---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<span>&copy; {today.getFullYear()} Nick Nieuwenhuis</span>

		<nav class="footer-links" aria-label="Footer navigation">
			<a href="/privacy">Privacy</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		margin-top: auto;
		border-top: 1px solid rgb(var(--gray-light));
		background: white;
		color: rgb(var(--gray));
		font-family: var(--font-atkinson);
	}

	.footer-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		width: 100%;
		max-width: 1120px;
		box-sizing: border-box;
		margin: 0 auto;
		padding: 1.1rem 1rem;
		font-size: 0.68em;
		line-height: 1.4;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.footer-links a {
		color: rgb(var(--gray));
		font-weight: 500;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.footer-links a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	@media (max-width: 600px) {
		.footer-content {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>