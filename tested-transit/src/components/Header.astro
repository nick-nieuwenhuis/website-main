---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2 class="site-title">
			<a href="/">{SITE_TITLE}</a>
		</h2>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About Me</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/speaking">Speaking</HeaderLink>
			<HeaderLink href="/research">Publications</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>

		<div class="header-actions">
			<div class="utility-links">
				<a
					class="search-button"
					href="/search"
					aria-label="Search website"
					title="Search"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M11 4a7 7 0 1 0 0 14a7 7 0 0 0 0-14zm5 12l4 4"
						/>
					</svg>
				</a>

				<!--
				Language switcher

				Temporarily disabled until Dutch language support is implemented.

				<div class="language-switcher">
					<button
						class="language-button"
						type="button"
						aria-label="Current language: English"
					>
						EN
					</button>

					<div class="language-menu">
						<button
							type="button"
							class="language-option"
							title="Dutch language support will be added later"
						>
							<span class="flag" aria-hidden="true">🇳🇱</span>
							<span>Nederlands</span>
						</button>
					</div>
				</div>
				-->
			</div>

			<div class="social-links">
				<a
					href="https://www.linkedin.com/in/nicknieuwenhuis94/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					title="LinkedIn"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.1 20.45H3.54V9H7.1v11.45z"
						/>
					</svg>
				</a>

				<a
					href="https://www.researchgate.net/profile/Nick-Nieuwenhuis"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="ResearchGate"
					title="ResearchGate"
					class="researchgate-link"
				>
					<span aria-hidden="true">
						R<sup>G</sup>
					</span>
				</a>

				<a
					href="https://github.com/nick-nieuwenhuis"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					title="GitHub"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M12 .7A11.3 11.3 0 0 0 8.43 22.72c.57.1.77-.25.77-.55v-2.16c-3.17.69-3.84-1.35-3.84-1.35-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.73-1.53-2.53-.29-5.19-1.26-5.19-5.59 0-1.24.44-2.25 1.18-3.04-.12-.29-.51-1.45.11-3 0 0 .96-.31 3.11 1.16A10.8 10.8 0 0 1 12 6.04c.96 0 1.92.13 2.83.38 2.15-1.47 3.11-1.16 3.11-1.16.62 1.55.23 2.71.11 3 .74.79 1.18 1.8 1.18 3.04 0 4.34-2.67 5.29-5.2 5.58.41.35.77 1.04.77 2.1v3.19c0 .3.21.66.78.55A11.3 11.3 0 0 0 12 .7z"
						/>
					</svg>
				</a>
			</div>

			<button
				class="menu-button"
				type="button"
				aria-label="Open navigation"
				aria-expanded="false"
				aria-controls="mobile-navigation"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>

		<div
			class="mobile-navigation"
			id="mobile-navigation"
		>
			<a href="/">Home</a>
			<a href="/about">About Me</a>
			<a href="/blog">Blog</a>
			<a href="/speaking">Speaking</a>
			<a href="/research">Publications</a>
			<a href="/contact">Contact</a>
		</div>
	</nav>
</header>

<script>
	const menuButton =
		document.querySelector('.menu-button');

	const mobileNavigation =
		document.querySelector('.mobile-navigation');

	if (
		menuButton instanceof HTMLButtonElement &&
		mobileNavigation instanceof HTMLElement
	) {
		menuButton.addEventListener('click', () => {
			const isOpen =
				menuButton.getAttribute('aria-expanded') === 'true';

			menuButton.setAttribute(
				'aria-expanded',
				String(!isOpen)
			);

			menuButton.setAttribute(
				'aria-label',
				isOpen
					? 'Open navigation'
					: 'Close navigation'
			);

			menuButton.classList.toggle(
				'is-open',
				!isOpen
			);

			mobileNavigation.classList.toggle(
				'is-open',
				!isOpen
			);
		});

		mobileNavigation
			.querySelectorAll('a')
			.forEach((link) => {
				link.addEventListener('click', () => {
					menuButton.setAttribute(
						'aria-expanded',
						'false'
					);

					menuButton.setAttribute(
						'aria-label',
						'Open navigation'
					);

					menuButton.classList.remove('is-open');
					mobileNavigation.classList.remove('is-open');
				});
			});
	}
</script>

<style>
	header {
		position: relative;
		z-index: 100;
		margin: 0;
		padding: 0 1.5em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		font-family: var(--font-atkinson);
	}

	nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 5rem;
		min-height: 72px;
	}

	.site-title {
		margin: 0;
		font-family: var(--font-atkinson);
		font-size: 0.88em;
		font-weight: 600;
		white-space: nowrap;
	}

	.site-title a,
	.site-title a.active {
		text-decoration: none;
	}

	nav a {
		color: rgb(var(--black));
		text-decoration: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.internal-links :global(a) {
		padding: 1.35em 0.45em;
		border-bottom: 3px solid transparent;
		font-size: 0.82em;
		font-weight: 500;
	}

	.internal-links :global(a.active) {
		border-bottom-color: var(--accent);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.utility-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.search-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 38px;
		box-sizing: border-box;
		padding: 0;
		border: 1.5px solid rgb(180, 187, 200);
		border-radius: 6px;
		background: rgb(247, 248, 250);
		color: rgb(var(--gray-dark));
	}

	.search-button:hover {
		border-color: rgb(145, 154, 170);
		background: rgb(238, 240, 244);
	}

	.search-button svg {
		width: 19px;
		height: 19px;
	}

	/*
	 * Language switcher
	 *
	 * Styling is intentionally kept here so the language switcher
	 * can easily be enabled later without rebuilding it.
	 */

	.language-switcher {
		position: relative;
		padding-bottom: 6px;
		margin-bottom: -6px;
	}

	.language-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 38px;
		box-sizing: border-box;
		padding: 0;
		border: 1.5px solid rgb(180, 187, 200);
		border-radius: 6px;
		background: rgb(247, 248, 250);
		color: rgb(var(--gray-dark));
		font-family: var(--font-atkinson);
		font-size: 0.72em;
		font-weight: 700;
		cursor: pointer;
	}

	.language-button:hover {
		border-color: rgb(145, 154, 170);
		background: rgb(238, 240, 244);
	}

	.language-menu {
		position: absolute;
		top: calc(100% + 4px);
		right: 0;
		z-index: 50;
		display: none;
		width: 175px;
		padding: 0.4rem;
		border: 1.5px solid rgb(180, 187, 200);
		border-radius: 7px;
		background: white;
		box-shadow: 0 8px 24px rgba(var(--black), 12%);
	}

	.language-switcher:hover .language-menu,
	.language-switcher:focus-within .language-menu {
		display: block;
	}

	.language-option {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		padding: 0.7rem 0.8rem;
		border: 0;
		border-radius: 4px;
		background: transparent;
		color: rgb(var(--gray-dark));
		font-family: var(--font-atkinson);
		font-size: 0.8em;
		text-align: left;
		cursor: pointer;
	}

	.language-option:hover {
		background: rgb(var(--gray-light));
	}

	.flag {
		font-size: 1.25em;
		line-height: 1;
	}

	/* Social links */

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-left: 1.5rem;
		border-left: 1.5px solid rgb(180, 187, 200);
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 38px;
		box-sizing: border-box;
		padding: 0;
		border: 1.5px solid transparent;
		border-radius: 6px;
		color: rgb(var(--gray-dark));
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.social-links a:hover {
		border-color: rgb(180, 187, 200);
		background: rgb(247, 248, 250);
		color: var(--accent);
	}

	.social-links svg {
		width: 20px;
		height: 20px;
	}

	.researchgate-link span {
		font-family: Arial, sans-serif;
		font-size: 18px;
		font-weight: 700;
		line-height: 1;
	}

	.researchgate-link sup {
		font-size: 8px;
	}

	/* Mobile navigation */

	.menu-button {
		display: none;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 4px;
		width: 42px;
		height: 38px;
		box-sizing: border-box;
		padding: 0;
		border: 1.5px solid rgb(180, 187, 200);
		border-radius: 6px;
		background: rgb(247, 248, 250);
		cursor: pointer;
	}

	.menu-button span {
		display: block;
		width: 17px;
		height: 1.5px;
		background: rgb(var(--gray-dark));
		transition:
			transform 0.15s ease,
			opacity 0.15s ease;
	}

	.menu-button:hover {
		border-color: rgb(145, 154, 170);
		background: rgb(238, 240, 244);
	}

	.menu-button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.menu-button.is-open span:nth-child(1) {
		transform: translateY(5.5px) rotate(45deg);
	}

	.menu-button.is-open span:nth-child(2) {
		opacity: 0;
	}

	.menu-button.is-open span:nth-child(3) {
		transform: translateY(-5.5px) rotate(-45deg);
	}

	.mobile-navigation {
		display: none;
	}

	/* Responsive */

	@media (max-width: 1050px) {
		.site-title {
			display: none;
		}
	}

	@media (max-width: 850px) {
		.social-links {
			display: none;
		}
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}

		nav {
			flex-wrap: wrap;
			gap: 0;
			min-height: 64px;
		}

		.site-title {
			display: block;
			flex: 1;
			font-size: 0.8em;
		}

		.internal-links {
			display: none;
		}

		.header-actions {
			gap: 0.5rem;
			margin-left: auto;
		}

		.social-links {
			display: none;
		}

		.menu-button {
			display: flex;
		}

		.mobile-navigation {
			order: 3;
			width: 100%;
			box-sizing: border-box;
			padding: 0;
			border-top: 1px solid rgb(var(--gray-light));
		}

		.mobile-navigation.is-open {
			display: flex;
			flex-direction: column;
			padding: 0.5rem 0 0.75rem;
		}

		.mobile-navigation a {
			display: block;
			padding: 0.65rem 0.15rem;
			color: rgb(var(--gray-dark));
			font-size: 0.78em;
			font-weight: 500;
			line-height: 1.3;
			text-decoration: none;
		}

		.mobile-navigation a:hover {
			color: var(--accent);
		}

		.mobile-navigation a + a {
			border-top: 1px solid rgba(var(--gray-light), 0.7);
		}
	}
</style>