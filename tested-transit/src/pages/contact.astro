---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Contact | Nick Nieuwenhuis"
			description="Get in touch with Nick Nieuwenhuis."
		/>

		<style>
			/* Header */

			.contact-header {
				max-width: none;
				margin-bottom: 2.75rem;
			}

			.contact-label {
				display: inline-block;
				margin-bottom: 0.8rem;
				color: var(--accent);
				font-size: 0.68em;
				font-weight: 600;
				line-height: 1.4;
				letter-spacing: 0.035em;
			}

			.contact-header h1 {
				margin: 0 0 0.8rem 0;
				font-size: clamp(2.6rem, 4.5vw, 3.8rem);
				line-height: 1.06;
				letter-spacing: -0.025em;
			}

			.contact-header p {
				max-width: none;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.82em;
				line-height: 1.6;
			}

			/* Main contact section */

			.contact-panel {
				padding: 3rem 0;
				border-top: 1.5px solid rgb(180, 187, 200);
				border-bottom: 1.5px solid rgb(180, 187, 200);
			}

			.contact-panel-top {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 3rem;
				align-items: center;
			}

			.contact-copy {
				min-width: 0;
			}

			.contact-copy h2 {
				margin: 0 0 0.65rem 0;
				font-size: 1.5em;
				line-height: 1.2;
			}

			.contact-copy p {
				max-width: none;
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 0.74em;
				line-height: 1.65;
			}

			/* Contact button */

			.contact-details {
				display: flex;
				align-items: center;
				gap: 1.25rem;
				margin-top: 2rem;
			}

			.contact-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				padding: 0.6rem 0.9rem;
				border: 5px solid var(--accent);
				border-radius: 5px;
				background: var(--accent);
				color: white;
				font-size: 0.75em;
				font-weight: 800;
				line-height: 1.8;
				text-decoration: none;
				white-space: nowrap;
				transition:
					background-color 0.15s ease,
					border-color 0.15s ease;
			}

			.contact-button:hover {
				border-color: var(--accent-dark);
				background: var(--accent-dark);
				color: white;
				text-decoration: none;
			}

			.contact-button:focus-visible,
			.privacy-link:focus-visible,
			.social-item:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
			}

			/* Privacy by design */

			.privacy-block {
				min-width: 250px;
				max-width: 330px;
				padding-left: 2rem;
				border-left: 1.5px solid rgb(180, 187, 200);
			}

			.privacy-block span {
				display: inline-block;
				margin-bottom: 0.45rem;
				color: var(--accent);
				font-size: 0.62em;
				font-weight: 600;
				line-height: 1.4;
				letter-spacing: 0.035em;
			}

			.privacy-block p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.66em;
				line-height: 1.6;
			}

			.privacy-link {
				display: inline-flex;
				margin-top: 0.65rem;
				color: var(--accent);
				font-size: 0.64em;
				font-weight: 600;
				text-decoration: none;
			}

			.privacy-link:hover {
				color: var(--accent-dark);
				text-decoration: underline;
			}
            
			.social-section {
				padding: 2.25rem 0 0;
			}

			.social-header {
				margin-bottom: 1.4rem;
			}

			.social-header .section-kicker {
				display: inline-block;
				margin-bottom: 0.35rem;
				color: var(--accent);
				font-size: 0.66em;
				font-weight: 600;
				line-height: 1.4;
				letter-spacing: 0.035em;
			}

			.social-header h2 {
				margin: 0 0 0.4rem 0;
				font-size: 1.35em;
				line-height: 1.2;
			}

			.social-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.7em;
				line-height: 1.6;
			}

			.social-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				border-top: 1px solid rgb(205, 211, 220);
				border-bottom: 1px solid rgb(205, 211, 220);
			}

			.social-item {
				display: flex;
				flex-direction: column;
				min-width: 0;
				padding: 1.25rem 1.4rem;
				color: rgb(var(--black));
				text-decoration: none;
				transition:
					color 0.15s ease,
					background-color 0.15s ease;
			}

			.social-item:first-child {
				padding-left: 0;
			}

			.social-item + .social-item {
				border-left: 1px solid rgb(205, 211, 220);
			}

			.social-name {
				margin-bottom: 0.15rem;
				font-size: 0.78em;
				font-weight: 700;
				line-height: 1.4;
			}

			.social-description {
				color: rgb(var(--gray));
				font-size: 0.62em;
				line-height: 1.5;
			}

			.social-arrow {
				width: fit-content;
				margin-top: 0.65rem;
				color: var(--accent);
				font-size: 0.7em;
				font-weight: 700;
				line-height: 1;
				transition: transform 0.15s ease;
			}

			.social-item:hover {
				background: rgba(var(--gray-light), 0.22);
				color: var(--accent);
				text-decoration: none;
			}

			.social-item:hover .social-arrow {
				transform: translateX(3px);
			}

			/* Responsive */

			@media (max-width: 800px) {
				.contact-panel-top {
					grid-template-columns: 1fr;
					gap: 2rem;
				}

				.privacy-block {
					max-width: none;
					padding: 1.5rem 0 0 0;
					border-top: 1px solid rgb(205, 211, 220);
					border-left: 0;
				}
			}

			@media (max-width: 600px) {
				.contact-header {
					margin-bottom: 2.25rem;
				}

				.contact-header h1 {
					font-size: 2.5rem;
				}

				.contact-header p {
					font-size: 0.76em;
				}

				.contact-panel {
					padding: 2rem 0;
				}

				.contact-details {
					margin-top: 1.5rem;
				}

				.social-section {
					padding-top: 2rem;
				}

				.social-header {
					margin-bottom: 1rem;
				}

				.social-header h2 {
					font-size: 1.25em;
				}

				.social-grid {
					display: flex;
					flex-direction: column;
				}

				.social-item,
				.social-item:first-child {
					display: grid;
					grid-template-columns:
						minmax(105px, 0.7fr)
						minmax(0, 1fr)
						auto;
					gap: 0.75rem;
					align-items: center;
					padding: 0.9rem 0.15rem;
					border-left: 0;
				}

				.social-item + .social-item {
					border-top: 1px solid rgb(205, 211, 220);
					border-left: 0;
				}

				.social-name {
					margin: 0;
					font-size: 0.72em;
				}

				.social-description {
					font-size: 0.6em;
				}

				.social-arrow {
					margin: 0;
					font-size: 0.72em;
				}

				.social-item:hover {
					background: transparent;
				}
			}

			@media (max-width: 480px) {
				.contact-header h1 {
					font-size: 2.2rem;
				}

				.social-item,
				.social-item:first-child {
					grid-template-columns:
						minmax(100px, 0.8fr)
						minmax(0, 1fr)
						auto;
					gap: 0.55rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<header class="contact-header">
				<span class="contact-label">Get in touch</span>

				<h1>Let's talk.</h1>

				<p>
					Have a question, an idea to discuss or interested in working together?
					Click the button below to send me an email.
				</p>
			</header>

			<section class="contact-panel">
				<div class="contact-panel-top">
					<div class="contact-copy">
						<h2>Send me an email</h2>

						<p>
							Whether it's about cybersecurity, research, speaking or something
							completely different, feel free to reach out. A little context about
							your question or request is always helpful.
						</p>

						<div class="contact-details">
							<a
								class="contact-button"
								href="mailto:nick@nicknieuwenhuis.com"
							>
								Contact me →
							</a>
						</div>
					</div>

					<aside class="privacy-block">
						<span>PRIVACY BY DESIGN</span>

						<p>
							This website does not use a contact form or advanced tracking.
							Your message is sent directly through your own email provider.
						</p>

						<a
							class="privacy-link"
							href="/privacy"
						>
							Privacy Statement →
						</a>
					</aside>
				</div>
			</section>

			<section class="social-section">
				<div class="social-header">
					<span class="section-kicker">
						Stay connected
					</span>

					<h2>Follow my work</h2>

					<p>
						I regularly share updates, research and other work through these platforms.
					</p>
				</div>

				<div class="social-grid">
					<a
						class="social-item"
						href="https://www.linkedin.com/in/nicknieuwenhuis94/"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="social-name">
							LinkedIn
						</span>

						<span class="social-description">
							Updates & writing
						</span>

						<span
							class="social-arrow"
							aria-hidden="true"
						>
							↗
						</span>
					</a>

					<a
						class="social-item"
						href="https://www.researchgate.net/profile/Nick-Nieuwenhuis"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="social-name">
							ResearchGate
						</span>

						<span class="social-description">
							Research & papers
						</span>

						<span
							class="social-arrow"
							aria-hidden="true"
						>
							↗
						</span>
					</a>

					<a
						class="social-item"
						href="https://github.com/nick-nieuwenhuis"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="social-name">
							GitHub
						</span>

						<span class="social-description">
							Projects & code
						</span>

						<span
							class="social-arrow"
							aria-hidden="true"
						>
							↗
						</span>
					</a>

					<a
						class="social-item"
						href="https://nedscaper.com"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="social-name">
							Nedscaper
						</span>

						<span class="social-description">
							Professional work
						</span>

						<span
							class="social-arrow"
							aria-hidden="true"
						>
							↗
						</span>
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>