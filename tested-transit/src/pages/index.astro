---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<div class="hero-content">
					<span class="hero-label">
						Cybersecurity Architect · Researcher · Speaker
					</span>

					<h1>Security architecture for a changing digital world.</h1>

					<p class="hero-intro">
						I work at the intersection of cybersecurity, architecture and risk management,
						helping organizations navigate today's security challenges while
						preparing for what comes next.
					</p>

					<div class="hero-actions">
						<a class="primary-link" href="/about">
							About me →
						</a>

						</div>
				</div>

				<div class="hero-visual">
					<img
						src="/images/home/portrait.png"
						alt="Portrait"
					/>
				</div>
			</section>

			<nav class="home-navigation" aria-label="Explore the website">
				<a href="/blog" class="home-nav-item">
					<span class="nav-number">01</span>

					<div>
						<h2>Blogs</h2>
						<p>
							Thoughts and perspectives on cybersecurity and emerging technology.
						</p>
					</div>

					<span class="nav-arrow">→</span>
				</a>

				<a href="/speaking" class="home-nav-item">
					<span class="nav-number">02</span>

					<div>
						<h2>Speaking</h2>
						<p>
							Sessions on cybersecurity, resilience, architecture and quantum security.
						</p>
					</div>

					<span class="nav-arrow">→</span>
				</a>

				<a href="/research" class="home-nav-item">
					<span class="nav-number">03</span>

					<div>
						<h2>Publications</h2>
						<p>
							Academic research, professional publications and conference contributions.
						</p>
					</div>

					<span class="nav-arrow">→</span>
				</a>

			</nav>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* Hero */

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		gap: 4rem;
		align-items: center;
		min-height: 520px;
		padding: 2rem 0 4rem;
	}

	.hero-content {
		min-width: 0;
	}

	.hero-label {
		display: inline-block;
		margin-bottom: 1.1rem;
		color: var(--accent);
		font-size: 0.68em;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: 0.035em;
	}

	.hero h1 {
		max-width: 680px;
		margin: 0 0 1.25rem 0;
		font-size: clamp(2.6rem, 4.5vw, 3.8rem);
		line-height: 1.06;
		letter-spacing: -0.025em;
	}

	.hero-intro {
		max-width: 650px;
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.9em;
		line-height: 1.65;
	}

	/* Hero actions */

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.4rem;
		margin-top: 1.75rem;
	}

	.primary-link,
	.secondary-link {
		display: inline-flex;
		align-items: center;
		font-size: 0.72em;
		font-weight: 600;
		text-decoration: none;
	}

	.primary-link {
		padding: 0.55rem 0.85rem;
		border: 1px solid var(--accent);
		border-radius: 5px;
		background: var(--accent);
		color: white;
	}

	.primary-link:hover {
		border-color: var(--accent-dark);
		background: var(--accent-dark);
		color: white;
	}

	.secondary-link {
		color: var(--accent);
	}

	.secondary-link:hover {
		color: var(--accent-dark);
		text-decoration: underline;
	}

	.primary-link:focus-visible,
	.secondary-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* Portrait */

	.hero-visual {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-height: 430px;
	}

	.hero-visual img {
		display: block;
		width: 100%;
		max-width: 380px;
		height: auto;
		object-fit: contain;
	}

	/* Home navigation */

	.home-navigation {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1.5px solid rgb(180, 187, 200);
		border-bottom: 1.5px solid rgb(180, 187, 200);
	}

	.home-nav-item {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 0.9rem;
		align-items: start;
		padding: 1.5rem;
		color: rgb(var(--black));
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.home-nav-item + .home-nav-item {
		border-left: 1.5px solid rgb(180, 187, 200);
	}

	.home-nav-item:hover {
		background: rgba(var(--gray-light), 0.35);
		color: rgb(var(--black));
	}

	.home-nav-item:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.nav-number {
		padding-top: 0.15rem;
		color: rgb(var(--gray));
		font-size: 0.58em;
		font-weight: 600;
	}

	.home-nav-item h2 {
		margin: 0 0 0.4rem 0;
		font-size: 1.05em;
		line-height: 1.2;
	}

	.home-nav-item p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.65em;
		line-height: 1.5;
	}

	.nav-arrow {
		color: var(--accent);
		font-size: 0.8em;
		font-weight: 600;
	}

	/* Responsive */

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
			gap: 2rem;
		}

		.hero h1 {
			font-size: clamp(2.5rem, 6vw, 3.5rem);
		}

		.hero-visual {
			min-height: 360px;
		}

		.hero-visual img {
			max-width: 340px;
		}
	}

	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			min-height: auto;
			padding: 1rem 0 3rem;
		}

		.hero-visual {
			justify-content: flex-start;
			min-height: auto;
		}

		.hero-visual img {
			width: 100%;
			max-width: 380px;
		}

		.home-navigation {
			grid-template-columns: 1fr;
		}

		.home-nav-item + .home-nav-item {
			border-left: 0;
			border-top: 1.5px solid rgb(180, 187, 200);
		}
	}

	@media (max-width: 480px) {
		.hero h1 {
			font-size: 2.5rem;
		}

		.hero-intro {
			font-size: 0.85em;
		}

		.hero-actions {
			gap: 1rem;
		}

		.home-nav-item {
			padding: 1.25rem 0.75rem;
		}
	}
</style>